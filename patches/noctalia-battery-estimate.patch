@@ -250,11 +265,48 @@
     return match ? match.icon : "battery-off"; // New fallback icon clearly represent if nothing is true here.
   }
 
+  function sampleDischargeRate() {
+    const device = primaryDevice;
+    if (!device || isBluetoothDevice(device) || device.changeRate === undefined) {
+      return;
+    }
+
+    const rate = Math.abs(device.changeRate);
+    if (!isFinite(rate) || rate <= 0) {
+      return;
+    }
+
+    smoothedDischargeRate = smoothedDischargeRate > 0
+        ? smoothedDischargeRate * 0.7 + rate * 0.3
+        : rate;
+  }
+
+  function getEstimatedTimeToEmpty(device) {
+    if (!device || isBluetoothDevice(device)) {
+      return device?.timeToEmpty || 0;
+    }
+
+    const energy = Number(device.energy || 0);
+    const fullEnergy = Number(device.energyCapacity || 0);
+    const measuredRate = device === primaryDevice && smoothedDischargeRate > 0
+        ? smoothedDischargeRate
+        : Math.abs(Number(device.changeRate || 0));
+    const targetRate = fullEnergy > 0 ? fullEnergy / targetRuntimeHours : 0;
+    const effectiveRate = Math.max(measuredRate, targetRate);
+
+    if (energy > 0 && effectiveRate > 0) {
+      return energy * 3600 / effectiveRate;
+    }
+    return device.timeToEmpty || 0;
+  }

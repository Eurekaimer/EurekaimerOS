# hyprlock 锁屏配置：壁纸铺满 + 居中密码输入，仿登录屏（regreet）风格
# 壁纸与开机登录界面一致（login-wallpaper.png），配色采样自 regreet.css

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}

# 背景：开机登录界面同一张壁纸，Cover 铺满，不模糊
background {
    monitor =
    color = rgba(23, 21, 34, 1.0)
    path = @loginWallpaper@
}

# 顶部问候语（对应登录界面的「欢迎回来」）
label {
    monitor =
    text = 欢迎回来
    font_family = "LXGW WenKai Screen"
    font_size = 20
    color = rgba(238, 242, 255, 0.75)
    position = 0, 235
    halign = center
    valign = center
}

# 大时钟
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    font_family = "LXGW WenKai Screen"
    font_size = 72
    color = rgba(238, 242, 255, 0.95)
    position = 0, 150
    halign = center
    valign = center
}

# 日期（中文星期）
label {
    monitor =
    text = cmd[update:60000] date +"%Y年%m月%d日  %A"
    font_family = "LXGW WenKai Screen"
    font_size = 20
    color = rgba(203, 214, 242, 0.85)
    position = 0, 80
    halign = center
    valign = center
}

# 居中密码输入框
input-field {
    monitor =
    size = 360, 56
    outline_thickness = 2
    rounding = 14
    dots_size = 0.18
    dots_spacing = 0.35
    dots_center = true

    inner_color = rgba(23, 21, 34, 0.45)
    outer_color = rgba(194, 207, 240, 0.9)
    font_color = rgba(238, 242, 255, 1.0)
    check_color = rgba(194, 207, 240, 1.0)
    fail_color = rgba(243, 139, 168, 1.0)

    font_family = "LXGW WenKai Screen"
    fade_on_empty = true
    placeholder_text = <i>输入密码解锁</i>
    fail_text = <i>密码错误，请重试</i>
    hide_input = false

    position = 0, -55
    halign = center
    valign = center
}

# 底部引导词（对应登录屏的输入提示）
label {
    monitor =
    text = 输入密码后按 Enter 解锁
    font_family = "LXGW WenKai Screen"
    font_size = 14
    color = rgba(238, 242, 255, 0.55)
    position = 0, -110
    halign = center
    valign = center
}

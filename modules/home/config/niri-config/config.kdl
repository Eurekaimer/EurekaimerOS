// ==========================================
// 1. 系统与自启动 (Startup & Environment)
// ==========================================
prefer-no-csd

spawn-at-startup "sh" "-c" "sleep 1 && swww img /etc/nixos/modules/home/swww/Muzomi.png --transition-type wipe"

spawn-at-startup "sh" "-c" "systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE GLFW_IM_MODULE INPUT_METHOD XMODIFIERS NIXOS_OZONE_WL; dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE GLFW_IM_MODULE INPUT_METHOD XMODIFIERS NIXOS_OZONE_WL"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "polkit-kde-authentication-agent-1"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "xembedsniproxy"
spawn-at-startup "noctalia-shell"

environment {
    LANG "zh_CN.UTF-8"
    LC_ALL "zh_CN.UTF-8"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "fcitx"
    INPUT_METHOD "fcitx"
    XMODIFIERS "@im=fcitx"
    NIXOS_OZONE_WL "1"
}

// ==========================================
// 2. 输入设备 (Input Devices)
// ==========================================
input {
    keyboard {
        xkb { options "caps:super,shift:both_capslock"; }
        numlock
    }

    mod-key "Super"

    touchpad {
        tap
        natural-scroll
    }
}

// ==========================================
// 3. 窗口布局与外观 (Layout & Visuals)
// ==========================================
layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#8FBCBB"
        inactive-color "#4C566A"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000070"
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

hotkey-overlay {
    hide-not-bound
}

// ==========================================
// 4. 动画效果 (Animations)
// ==========================================
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

// ==========================================
// 5. 窗口规则 (Window Rules)
// ==========================================
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="steam"
    default-column-width { proportion 0.7; }
}

// ==========================================
// 6. 快捷键绑定 (Keybinds)
// ==========================================
binds {
    // --- 核心应用启动 ---
    Mod+Shift+Slash hotkey-overlay-title="帮助：显示快捷键" { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="启动：终端 Kitty" { spawn "kitty"; }
    Mod+R hotkey-overlay-title="输入法：切换 Fcitx5" { spawn "fcitx5-remote" "-t"; }

    // Noctalia 官方推荐 IPC 方式
    Mod+Space hotkey-overlay-title="启动：应用启动器" { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+S hotkey-overlay-title="系统：控制中心" { spawn "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+Comma hotkey-overlay-title="系统：打开设置" { spawn "noctalia-shell" "ipc" "call" "settings" "toggle"; }

    // --- 硬件控制 (切到 Noctalia IPC，统一 OSD/状态) ---
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia-shell" "ipc" "call" "volume" "increase"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia-shell" "ipc" "call" "volume" "decrease"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia-shell" "ipc" "call" "volume" "muteOutput"; }

    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia-shell" "ipc" "call" "brightness" "decrease"; }

    // --- 窗口操作 ---
    Mod+Q hotkey-overlay-title="窗口：关闭当前窗口" { close-window; }
    Mod+V hotkey-overlay-title="窗口：切换浮动/平铺" { toggle-window-floating; }
    Mod+F hotkey-overlay-title="窗口：最大化当前列" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="窗口：全屏当前窗口" { fullscreen-window; }

    // --- 分屏布局 ---
    Mod+BracketLeft hotkey-overlay-title="布局：与左侧窗口合并/分离" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="布局：与右侧窗口合并/分离" { consume-or-expel-window-right; }
    Mod+Equal hotkey-overlay-title="布局：当前列宽设为 50%" { set-column-width "50%"; }
    Mod+Shift+Equal hotkey-overlay-title="布局：当前窗口高度设为 50%" { set-window-height "50%"; }
    Mod+Backspace hotkey-overlay-title="布局：重置窗口高度" { reset-window-height; }
    Mod+Alt+H hotkey-overlay-title="布局：当前列窄一点" { set-column-width "-5%"; }
    Mod+Alt+L hotkey-overlay-title="布局：当前列宽一点" { set-column-width "+5%"; }
    Mod+Alt+J hotkey-overlay-title="布局：当前窗口高一点" { set-window-height "+5%"; }
    Mod+Alt+K hotkey-overlay-title="布局：当前窗口矮一点" { set-window-height "-5%"; }

    // --- 焦点移动 ---
    Mod+H     hotkey-overlay-title="焦点：切到左侧列" { focus-column-left; }
    Mod+L     hotkey-overlay-title="焦点：切到右侧列" { focus-column-right; }
    Mod+J     hotkey-overlay-title="焦点：切到下方窗口" { focus-window-down; }
    Mod+K     hotkey-overlay-title="焦点：切到上方窗口" { focus-window-up; }

    // --- 移动窗口位置 ---
    Mod+Ctrl+H     hotkey-overlay-title="移动：当前列左移" { move-column-left; }
    Mod+Ctrl+L     hotkey-overlay-title="移动：当前列右移" { move-column-right; }
    Mod+Ctrl+J     hotkey-overlay-title="移动：窗口下移" { move-window-down; }
    Mod+Ctrl+K     hotkey-overlay-title="移动：窗口上移" { move-window-up; }

    // --- 工作区切换 ---
    Mod+1 hotkey-overlay-title="工作区：切到 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="工作区：切到 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="工作区：切到 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="工作区：切到 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="工作区：切到 5" { focus-workspace 5; }

    // --- 移动窗口到指定工作区 ---
    Mod+Shift+1 hotkey-overlay-title="工作区：当前列移到 1" { move-column-to-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title="工作区：当前列移到 2" { move-column-to-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title="工作区：当前列移到 3" { move-column-to-workspace 3; }

    // --- 退出与锁屏 ---
    Mod+Shift+E hotkey-overlay-title="会话：退出 niri" { quit; }
    Mod+Shift+L hotkey-overlay-title="会话：锁屏" { spawn "hyprlock"; }

    Print hotkey-overlay-title="截图：打开截图工具" { screenshot; }
    Mod+Print hotkey-overlay-title="录屏：选择区域开始录制" { spawn "sh" "-c" "mkdir -p \"$HOME/Videos/Screencasts\" && wf-recorder -g \"$(slurp)\" -f \"$HOME/Videos/Screencasts/Recording_$(date +%F_%H-%M-%S).mp4\""; }
    Mod+Shift+Print hotkey-overlay-title="录屏：停止录制" { spawn "pkill" "-INT" "wf-recorder"; }
}
